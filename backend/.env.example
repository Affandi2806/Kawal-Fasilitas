# ---- Supabase ----
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Auth (JWT manual) ----
# Generate random: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=7d

# ---- Login Google (warga) ----
# Buat di Google Cloud Console > APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Web application.
# Authorized JavaScript origins: https://kawalfasilitas.web.id
# (tambah http://localhost:3001 untuk dev FE). Client ID yang sama
# dipakai FE sebagai NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=isi_dengan_oauth_client_id_google

# ---- Supabase Storage ----
# Bucket foto laporan (buat di Dashboard > Storage, set Public)
SUPABASE_STORAGE_BUCKET=foto-laporan
